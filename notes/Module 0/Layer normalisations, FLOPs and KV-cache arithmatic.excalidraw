entId":"QhXnX75cfTPqD1Y5NTOId"},"versionNonce":1991974705,"frameId":null,"boundElements":[],"x":403.18157255640824,"angle":6.2738141084231316,"y":265.71519801865901,"width":82.680349864575959},{"seed":417037727,"strokeStyle":"solid","id":"2AXss1M5_25PgjDeCa1x6","strokeWidth":1,"roughness":0,"isDeleted":false,"startBinding":{"mode":"orbit","fixedPoint":[0.50009999999999999,0],"elementId":"opR8VqSCSsSnMWmx9aaob"},"endArrowhead":"arrow","created":1794707823747,"opacity":100,"updated":1794709295554,"locked":false,"points":[[0,0],[-5.6149594313541016,-21.67535487294354],[-75.90791800047424,-22.719831664281845]],"version":280,"elbowed":false,"type":"arrow","backgroundColor":"#b2f2bb","index":"b8G","roundness":{"type":2},"height":22.719831664281845,"link":null,"startArrowhead":null,"strokeColor":"#1e1e1e","fillStyle":"cross-hatch","groupIds":[],"endBinding":null,"versionNonce":1030645855,"frameId":null,"boundElements":[],"x":482.91872909087772,"angle":6.2738141084231316,"y":116.84752177714751,"width":75.90791800047424},{"seed":217608639,"strokeStyle":"solid","id":"8g0YNPHkXjanxuH0W8rrm","strokeWidth":1,"roughness":0,"isDeleted":false,"fontSize":17.438212544760155,"created":1794707823747,"labelPosition":null,"opacity":100,"verticalAlign":"top","updated":1794709295554,"locked":false,"text":"Why pre-norm is better than post-norm?\n","baseFontSize":null,"version":188,"autoResize":true,"type":"text","backgroundColor":"#b2f2bb","index":"b8H","roundness":null,"containerId":null,"originalText":"Why pre-norm is better than post-norm?\n","height":43.595531361900377,"link":null,"strokeColor":"#e03131","fillStyle":"cross-hatch","groupIds":[],"versionNonce":1699877137,"textAlign":"left","fontFamily":5,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":-371.64907080954936,"angle":0,"y":573.32083680641688,"width":338.78958453876203},{"seed":899801567,"strokeStyle":"solid","id":"cF5EqRhHI8HTm_XwdLfLr","strokeWidth":1,"roughness":0,"isDeleted":false,"fontSize":16,"created":1794707823747,"labelPosition":null,"opacity":100,"verticalAlign":"top","updated":1794709295554,"locked":false,"text":"1. In Pre-Norm, Layer Normalization is placed before the attention\nor feed-forward sublayer (Norm → Sublayer → Add). This means\nthe residual connection path bypasses normalization, creating a\nclean path for gradients to flow\n\n2. As gradient flows from the deeper blocks to straight to the\nbottom blocks so it is much easier to train very very deep\nnetworks.\n\n3. No Learning Rate Warmup Required: Because the gradient flow is\nsmooth and stable, Pre-Norm models do not suffer from early\ntraining divergence.\n","baseFontSize":null,"version":348,"autoResize":false,"type":"text","backgroundColor":"#b2f2bb","index":"b8I","roundness":null,"containerId":null,"originalText":"1. In Pre-Norm, Layer Normalization is placed before the attention or feed-forward sublayer (Norm → Sublayer → Add). This means the residual connection path bypasses normalization, creating a clean path for gradients to flow\n\n2. As gradient flows from the deeper blocks to straight to the bottom blocks so it is much easier to train very very deep networks.\n\n3. No Learning Rate Warmup Required: Because the gradient flow is smooth and stable, Pre-Norm models do not suffer from early training divergence.\n","height":260,"link":null,"strokeColor":"#1e1e1e","fillStyle":"cross-hatch","groupIds":[],"versionNonce":1566573695,"textAlign":"left","fontFamily":5,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":-372.21072884960313,"angle":0,"y":606.12442775718853,"width":532.69743152892772},{"seed":1139297791,"strokeStyle":"dotted","id":"UIebHr9JIjDoHLx40MC3H","strokeWidth":1,"roughness":0,"isDeleted":false,"startBinding":null,"endArrowhead":"arrow","created":1794707823747,"opacity":30,"updated":1794709295554,"locked":false,"points":[[0,0],[1.400085481164183,619.99237371520474]],"version":258,"elbowed":false,"type":"arrow","backgroundColor":"#b2f2bb","index":"b8J","roundness":{"type":2},"height":